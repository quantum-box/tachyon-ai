<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by the Mac App Store and TestFlight. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Recording while fn is held. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Tachyon API, OpenAI Realtime API. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Attaching files the user picks in the chat window. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- Importing Chrome's cookies into the browser pane without asking for the folder. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>/Library/Application Support/Google/Chrome/</string>
    </array>
    <!-- Passkeys (1Password, iCloud Keychain) for any site in the browser pane.
         Granted by Apple on request; signing fails until it is on the App ID. -->
    <key>com.apple.developer.web-browser.public-key-credential</key>
    <true/>
</dict>
</plist>
